# Copy to bot.env and fill in. Keep bot.env out of git.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs the bot answers in. Messages from any other
# chat are ignored and their chat ID is logged, so leave this empty at first,
# message the bot, and copy the ID from `docker compose logs`. Group chat IDs
# are negative.
ALLOWED_TELEGRAM_CHATS=

# From running `claude setup-token` once on any machine signed in to your
# Claude subscription. Valid for one year.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional.
CLAUDE_MODEL=sonnet
SESSION_IDLE_MINUTES=30
