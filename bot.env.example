# Copy to bot.env and fill in. Keep bot.env out of git.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot. Everyone else is
# ignored. Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# From running `claude setup-token` once on any machine signed in to your
# Claude subscription. Valid for one year.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional.
CLAUDE_MODEL=sonnet
SESSION_IDLE_MINUTES=30
