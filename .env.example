# Copy to .env and fill in. Keep .env out of git.

SONARR_URL=http://192.168.1.50:8989
SONARR_API_KEY=

RADARR_URL=http://192.168.1.50:7878
RADARR_API_KEY=

# Library folders. Each must match a root folder in the service exactly
# (Settings > Media Management > Root Folders). Blank uses the first one.
SONARR_ROOT_FOLDER=/data/media/tv
RADARR_ROOT_FOLDER=/data/media/movies

# Optional per-category folders. A category without one uses the folder above.
# SONARR_ROOT_FOLDER_ANIME=/data/media/anime
# RADARR_ROOT_FOLDER_ANIME=/data/media/anime-movies
# RADARR_ROOT_FOLDER_STANDUP=/data/media/standup

# Quality profile by name. Blank uses the first one the service returns.
# Optional per category: SONARR_QUALITY_PROFILE_ANIME, RADARR_QUALITY_PROFILE_ANIME,
# RADARR_QUALITY_PROFILE_STANDUP
SONARR_QUALITY_PROFILE=
RADARR_QUALITY_PROFILE=
