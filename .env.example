# Copy to .env and fill in. Keep .env out of git.

SONARR_URL=http://media-mgmt.lan:8989
SONARR_API_KEY=

RADARR_URL=http://media-mgmt.lan:7878
RADARR_API_KEY=

# Library folders per category. Each must match a root folder in the service exactly.
SONARR_ROOT_FOLDER=/mnt/smb-videos-tv/TV Shows
SONARR_ROOT_FOLDER_ANIME=/mnt/smb-videos-tv/Anime/Shows
RADARR_ROOT_FOLDER=/mnt/smb-videos-movies/Movies
RADARR_ROOT_FOLDER_ANIME=/mnt/smb-videos-movies/Anime
RADARR_ROOT_FOLDER_STANDUP=/mnt/smb-videos-tv/Standup

# Quality profile by name. Blank uses the first one the service returns.
# Optional per category: SONARR_QUALITY_PROFILE_ANIME, RADARR_QUALITY_PROFILE_ANIME,
# RADARR_QUALITY_PROFILE_STANDUP
SONARR_QUALITY_PROFILE=1080p/4k
RADARR_QUALITY_PROFILE=Ultra-HD
